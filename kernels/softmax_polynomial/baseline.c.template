#include <math.h>
#include <stdint.h>

#ifdef __cplusplus
extern "C" {
#endif

// Reference exp_kernel for softmax_polynomial: libm exp (no Chebyshev pass).
// softmax.c calls this symbol from softmax_kernel, so this variant produces
// the libm-grade reference runtime against which the xDSL polynomial variants
// (linalg_xdsl_b<N>) are compared.
void exp_kernel(const DTYPE *x, DTYPE *z) {
    for (uint32_t i = 0; i < N; ++i) {
        z[i] = EXPF(x[i]);
    }
}

#ifdef __cplusplus
}
#endif
